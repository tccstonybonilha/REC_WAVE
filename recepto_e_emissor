// Fecha o caractere em andamento, se houver. Ao final o
// receptor sempre volta para o modo ALFA (modos sao
// absolutos e valem para um unico caractere).
void finalizarCaractere() {
  if (simbolosRx.length() == 0) {
    descartandoRx = false;
    modoIdRx = ID_ALFA;
    return;
  }

  char c = 0;
  const char *motivo = nullptr;

  if (descartandoRx) {
    motivo = "sequencia longa demais";
  }
  else if (modoIdRx == ID_ALFA) {
    c = decodificarMorse(simbolosRx);
  }
  else if (modoIdRx == ID_NUMERICO) {
    c = decodificarNumero(simbolosRx);
  }
  else {
    if ((int)simbolosRx.length() < BITS_ESPECIAL) {
      motivo = "caractere especial incompleto";
    }
    else {
      c = decodificarEspecial(simbolosRx);
    }
  }

  if (motivo == nullptr && c == 0) {
    motivo = "codigo invalido";
  }

  if (motivo != nullptr) {
    adicionarErroCaractere(motivo);
  }
  else {
    charsRx += c;

    Serial.print("Caractere: '");
    Serial.print(c);
    Serial.print("' (modo ");
    Serial.print(nomeDoModoId(modoIdRx));
    Serial.println(")");
  }

  simbolosRx = "";
  descartandoRx = false;
  modoIdRx = ID_ALFA;
}

// Acrescenta um simbolo ao caractere em andamento. Se passar
// do maximo do modo, o caractere inteiro e marcado como erro
// e os simbolos restantes sao ignorados ate o proximo
// intervalo de fim de caractere (sem erros em cascata).
void acumularSimbolo(char simbolo) {
  if (descartandoRx) {
    return;
  }

  simbolosRx += simbolo;

  unsigned int maximo = BITS_ESPECIAL;

  if (modoIdRx == ID_ALFA) {
    maximo = 4;
  }
  else if (modoIdRx == ID_NUMERICO) {
    maximo = 3;
  }

  if (simbolosRx.length() > maximo) {
    descartandoRx = true;
  }
}

void iniciarMensagemRx() {
  resetarRecepcao();

  recebendoMensagem = true;
  modoIdRx = ID_ALFA;

  Serial.println("INICIO DA TRANSMISSAO RECEBIDA");
}

void finalizarMensagemRx() {
  // Caractere ainda aberto no momento do controle final.
  finalizarCaractere();

  Serial.println("FIM DA TRANSMISSAO RECEBIDA");

  Serial.println();
  Serial.println("======================================");

  int total = charsRx.length();

  if (total == 0) {
    Serial.println("MENSAGEM VAZIA (nenhum caractere decodificado).");
    Serial.println("======================================");
  }
  else {
    // O ultimo caractere recebido e o checksum.
    char recebido = charsRx[total - 1];
    String corpo = charsRx.substring(0, total - 1);
    bool corpoComErro = (corpo.indexOf(CHAR_ERRO) >= 0);

    Serial.println("TEXTO RECEBIDO:");
    Serial.println(montarTextoRx(corpo));
    Serial.println("======================================");

    if (recebido == CHAR_ERRO) {
      Serial.println(
        "INTEGRIDADE: NAO VERIFICADA (checksum ilegivel)."
      );
    }
    else if (corpoComErro) {
      Serial.println(
        "INTEGRIDADE: FALHOU (ha caracteres com [?])."
      );
    }
    else {
      char esperado = calcularChecksum(corpo);

      if (esperado == recebido) {
        Serial.println("INTEGRIDADE: OK (checksum confere).");
      }
      else {
        Serial.print("INTEGRIDADE: FALHOU. Checksum recebido '");
        Serial.print(recebido);
        Serial.print("', esperado '");
        Serial.print(esperado);
        Serial.println(
          "'. Algum bip foi lido errado, perdido ou inventado."
        );
      }
    }
  }

  if (errosRx > 0) {
    Serial.print("AVISO: ");
    Serial.print(errosRx);
    Serial.println(
      " erro(s) de decodificacao; os trechos marcados com [?] "
      "estao incorretos."
    );
  }

  Serial.println();

  totalMensagensRecebidas++;

  Serial.print("Pulsos validos: ");
  Serial.print(totalPulsosValidos);
  Serial.print(" | invalidos: ");
  Serial.print(totalPulsosInvalidos);
  Serial.print(" | ruidos curtos filtrados: ");
  Serial.print(totalRuidosFiltrados);
  Serial.print(" | ruidos continuos: ");
  Serial.println(totalRuidosContinuos);

  // As contagens acima valem por mensagem.
  totalPulsosValidos = 0;
  totalPulsosInvalidos = 0;
  totalRuidosFiltrados = 0;
  totalRuidosContinuos = 0;

  resetarRecepcao();
}

// ======================================================
// PROCESSA UM PULSO RECEBIDO
// Retorna true se o pulso foi aceito (e deve ser ecoado).
// ======================================================

bool processarPulso(const EventoPulso &ev, TipoSinal &tipoAceito) {
  // Dentro de uma mensagem, desconta o desvio medido no controle
  // inicial.
  unsigned long duracao = ev.duracao;

  if (COMPENSAR_COM_CONTROLE && recebendoMensagem && offsetRx != 0) {
    long corrigida = (long)duracao - offsetRx;

    if (corrigida < 0) {
      corrigida = 0;
    }

    duracao = (unsigned long)corrigida;
  }

  TipoSinal tipo = classificarDuracao(duracao);

  // Fora de mensagem, um LONGO "quase controle" e aceito como
  // controle de inicio (o controle pode sair curto por AGC).
  bool controleTolerado = false;

  if (!recebendoMensagem &&
      tipo == SINAL_LONGO &&
      duracao >= LIM_CONTROLE_TOLERANTE_MS) {
    tipo = SINAL_CONTROLE;
    controleTolerado = true;
  }

  Serial.print("Pulso: ");
  Serial.print(ev.duracao);

  if (duracao != ev.duracao) {
    Serial.print(" ms -> corrigido ");
    Serial.print(duracao);
  }

  Serial.print(" ms (pico ");
  Serial.print(ev.amplitudePico);
  Serial.print(" @");
  Serial.print(freqDoBin(ev.binPico));
  Serial.print(" Hz) -> ");
  Serial.print(nomeDoSinal(tipo));

  if (controleTolerado) {
    Serial.print(" (longo tolerado como controle de inicio)");
  }

  Serial.println();

  if (tipo == SINAL_INVALIDO) {
    totalPulsosInvalidos++;

    Serial.println(
      "Duracao fora dos limites (ruido): pulso rejeitado."
    );

    // Dentro de uma mensagem, o pulso rejeitado vira simbolo
    // desconhecido: o caractere sai como [?].
    if (recebendoMensagem) {
      ultimaAtividadeRx = ev.fimMs;
      acumularSimbolo('?');
    }

    return false;
  }

  totalPulsosValidos++;

  // ---- Controle de inicio / fim ----
  if (tipo == SINAL_CONTROLE) {
    ultimaAtividadeRx = ev.fimMs;

    if (!recebendoMensagem) {
      iniciarMensagemRx();

      if (COMPENSAR_COM_CONTROLE) {
        long desvio = (long)ev.duracao - (long)DUR_CONTROLE_MS;

        if (desvio > COMPENSACAO_MAX_MS) desvio = COMPENSACAO_MAX_MS;
        if (desvio < -COMPENSACAO_MAX_MS) desvio = -COMPENSACAO_MAX_MS;

        offsetRx = desvio;

        Serial.print("Compensacao de duracao: ");
        Serial.print(offsetRx);
        Serial.println(" ms");
      }
    }
    else {
      finalizarMensagemRx();
    }

    tipoAceito = tipo;
    return true;
  }

  if (!recebendoMensagem) {
    Serial.println(
      "Sinal ignorado: aguardando controle de inicio."
    );

    return false;
  }

  ultimaAtividadeRx = ev.fimMs;

  // ---- Sinal de modo (absoluto, vale para o proximo caractere) ----
  if (tipo == SINAL_MODO_NUMERICO ||
      tipo == SINAL_MODO_ESPECIAL) {

    // Os sinais de modo so existem entre caracteres. Se chegou
    // no meio de um caractere, e quase certamente ruido (clique):
    // ignora, sem estragar o caractere em andamento.
    if (simbolosRx.length() > 0) {
      Serial.println(
        "Sinal de modo no meio de um caractere: ignorado "
        "(provavel ruido)."
      );

      tipoAceito = tipo;
      return true;
    }

    modoIdRx = (tipo == SINAL_MODO_NUMERICO) ? ID_NUMERICO : ID_ESPECIAL;

    Serial.print("Modo do proximo caractere -> ");
    Serial.println(nomeDoModoId(modoIdRx));

    tipoAceito = tipo;
    return true;
  }

  // ---- Bip de dados (curto ou longo) ----
  acumularSimbolo(simboloChar(tipo, modoIdRx));

  if ((int)charsRx.length() > MAX_CARACTERES_RX) {
    Serial.println("ERRO: mensagem excedeu o limite de caracteres.");
    resetarRecepcao();
    return false;
  }

  tipoAceito = tipo;
  return true;
}

// ======================================================
// ECO DO PING-PONG
//
// Espera o som original terminar, aguarda ECO_ATRASO_MS e
// devolve um bip com a mesma duracao nominal. Depois ignora
// o microfone por um instante para nao processar o proprio
// eco e reinicia o detector.
// ======================================================

bool emitirEco(TipoSinal tipo) {
  if (!aguardarMs(ECO_ATRASO_MS)) {
    return false;
  }

  Serial.print("PONG: devolvendo eco ");
  Serial.print(nomeDoSinal(tipo));
  Serial.print(" (");
  Serial.print(duracaoDoSinal(tipo));
  Serial.println(" ms).");

  if (!tocarBip(duracaoDoSinal(tipo))) {
    return false;
  }

  // O intervalo seguinte e contado a partir do fim do eco,
  // que e o que o emissor tambem usa como referencia.
  ultimaAtividadeRx = millis();

  if (!aguardarMs(GUARDA_POS_EMISSAO_MS)) {
    return false;
  }

  detectorReiniciar();

  return true;
}

// ======================================================
// TEMPOS DO RECEPTOR: fim de caractere e mensagem incompleta
// ======================================================

void verificarTemposReceptor() {
  if (!recebendoMensagem || detSomAtivo) {
    return;
  }

  unsigned long silencio = millis() - ultimaAtividadeRx;

  if (silencio >= LIMITE_FIM_CARACTERE_MS) {
    if (simbolosRx.length() > 0) {
      finalizarCaractere();   // tambem volta para ALFA
    }
    else if (modoIdRx != ID_ALFA) {
      // Sinal de modo sem bips depois (provavel ruido).
      modoIdRx = ID_ALFA;
    }
  }

  if (silencio >= TIMEOUT_MENSAGEM_MS) {
    Serial.println(
      "ERRO: tempo limite de mensagem incompleta. "
      "Descartando e voltando a aguardar."
    );

    if (charsRx.length() > 0) {
      Serial.print("Texto parcial descartado: ");
      Serial.println(montarTextoRx(charsRx));
    }

    resetarRecepcao();
  }
}

// ======================================================
// CALIBRACAO
// :C        liga/desliga a leitura continua da amplitude
// :L<valor> ajusta o limiar minimo de deteccao (ex.: :L150)
// ======================================================

bool tratarComandoCalibracao(const String &comando) {
  if (comandoEh(comando, ":C")) {
    calibrando = !calibrando;

    if (calibrando) {
      calibInicioJanela = millis();
      calibMaxJanela = 0;
      calibSomaJanela = 0;
      calibBlocosJanela = 0;
      calibMaxTotal = 0;

      Serial.println("CALIBRACAO ATIVADA.");
      Serial.println(
        "1) Deixe em silencio e anote o 'max total'."
      );
      Serial.println(
        "2) Toque o buzzer e veja o 'max' durante os bips."
      );
      Serial.println(
        "3) Use :L<valor> com um valor entre os dois."
      );
      Serial.println(
        "4) O valor @... Hz e a frequencia do tom que o receptor ouve."
      );
      Serial.println("Digite :C para sair.");
    }
    else {
      Serial.print("CALIBRACAO ENCERRADA. Maximo visto: ");
      Serial.println(calibMaxTotal);
    }

    return true;
  }

  if (comando.length() > 2 &&
      comando[0] == ':' &&
      (comando[1] == 'L' || comando[1] == 'l') &&
      soDigitos(comando, 2)) {

    int valor = comando.substring(2).toInt();

    if (valor < 10 || valor > LIMIAR_MAXIMO) {
      Serial.print("Valor invalido. Use de 10 a ");
      Serial.println(LIMIAR_MAXIMO);
    }
    else {
      limiarMinimo = valor;
      atualizarLimiares();

      Serial.print("Limiar minimo ajustado para ");
      Serial.print(limiarMinimo);
      Serial.print(" (liga ");
      Serial.print(limiarOn);
      Serial.print(", desliga ");
      Serial.print(limiarOff);
      Serial.println(").");
    }

    return true;
  }

  // :T<hz> trava a escuta em torno de <hz> (+/- 2 bins, ~300 Hz).
  // :T0 volta para a escuta automatica (1100 a 3400 Hz).
  if (comando.length() > 2 &&
      comando[0] == ':' &&
      (comando[1] == 'T' || comando[1] == 't') &&
      soDigitos(comando, 2)) {

    int hz = comando.substring(2).toInt();

    if (hz == 0) {
      kMin = K_MIN_ABS;
      kMax = K_MAX_ABS;

      Serial.println("Escuta automatica (1100 a 3400 Hz).");
    }
    else if (hz < 1100 || hz > 3400) {
      Serial.println("Frequencia invalida. Use de 1100 a 3400 Hz, ou 0.");
      return true;
    }
    else {
      int k = (int)(hz * BLOCO_AMOSTRAS / SAMPLING_FREQUENCY + 0.5);

      kMin = k - 2;
      kMax = k + 2;

      if (kMin < K_MIN_ABS) kMin = K_MIN_ABS;
      if (kMax > K_MAX_ABS) kMax = K_MAX_ABS;

      Serial.print("Escuta travada de ");
      Serial.print(freqDoBin(kMin));
      Serial.print(" a ");
      Serial.print(freqDoBin(kMax));
      Serial.println(" Hz.");
    }

    detectorReiniciar();
    semearRuido();

    return true;
  }

  return false;
}

// Mostra a amplitude a cada 200 ms, sem processar pulsos.
void executarCalibracao() {
  int amplitude = lerAmplitudeBloco();

  if (amplitude > calibMaxJanela) {
    calibMaxJanela = amplitude;
    calibBinJanela = binDominante;
  }

  if (amplitude > calibMaxTotal) {
    calibMaxTotal = amplitude;
  }

  calibSomaJanela += amplitude;
  calibBlocosJanela++;

  if (millis() - calibInicioJanela >= 200) {
    Serial.print("max=");
    Serial.print(calibMaxJanela);
    Serial.print(" @");
    Serial.print(freqDoBin(calibBinJanela));
    Serial.print(" Hz media=");
    Serial.print(calibSomaJanela / calibBlocosJanela);
    Serial.print(" | liga=");
    Serial.print(limiarOn);
    Serial.print(" desliga=");
    Serial.print(limiarOff);
    Serial.print(" | max total=");
    Serial.println(calibMaxTotal);

    calibInicioJanela = millis();
    calibMaxJanela = 0;
    calibSomaJanela = 0;
    calibBlocosJanela = 0;
  }
}

// ======================================================
// MODO RECEBER
// ======================================================

void executarReceptor() {
  String comando;

  if (lerLinhaSerial(comando)) {
    if (comandoEh(comando, ":E") ||
        comandoEh(comando, ":EMITIR")) {
      definirModo(EMITIR);
      return;
    }

    if (!tratarComandoCalibracao(comando) &&
        comando.length() > 0 &&
        !comandoEh(comando, ":R") &&
        !comandoEh(comando, ":RECEBER")) {
      Serial.println(
        "Para emitir, digite :E e pressione ENTER."
      );
    }
  }

  if (modoAtual != RECEBER) {
    return;
  }

  if (calibrando) {
    executarCalibracao();
    return;
  }

  EventoPulso ev;

  if (detectorProcessar(ev)) {
    TipoSinal tipoAceito = SINAL_INVALIDO;

    bool aceito = processarPulso(ev, tipoAceito);

    if (PING_PONG_ATIVO && aceito && modoAtual == RECEBER) {
      emitirEco(tipoAceito);
    }

    return;
  }

  verificarTemposReceptor();
}

// ======================================================
// SETUP
// ======================================================

void setup() {
  Serial.begin(115200);

  pinMode(BUZZER_PIN, OUTPUT);
  pinMode(MIC_PIN, INPUT);

  // ADC do ESP32: 12 bits e faixa ~0 a 2,5 V (11 dB), que
  // comporta a saida do MAX9814 (polarizada em ~1,25 V).
  analogReadResolution(12);
  analogSetAttenuation(ADC_11db);
  analogSetPinAttenuation(MIC_PIN, ADC_11db);

  noTone(BUZZER_PIN);

  inicializarGoertzel();

  delay(1500);

  Serial.println();
  Serial.println("======================================");
  Serial.println("REC-WAVE v3");
  Serial.println("RECEPTOR, EMISSOR E CONVERSOR");
  Serial.println("PROTOCOLO POR DURACAO DOS BIPS");
  Serial.println("======================================");
  Serial.println();

  // Mede o tempo de cada analogRead. A amostragem de 10 kHz
  // exige menos de 100 us por amostra, ja contando uns 10 us
  // do calculo dos filtros.
  unsigned long t0 = micros();

  for (int i = 0; i < 200; i++) {
    analogRead(MIC_PIN);
  }

  float usPorLeitura = (micros() - t0) / 200.0f;

  Serial.print("Tempo do analogRead: ");
  Serial.print(usPorLeitura, 1);
  Serial.println(" us (limite: 80 us)");

  if (usPorLeitura > 80.0f) {
    Serial.println(
      "AVISO: ADC lento demais para 10 kHz. A taxa real fica "
      "menor e as frequencias lidas saem deslocadas."
    );
  }

  Serial.println();
  Serial.println("Escolha o modo inicial:");
  Serial.println("E = Emitir");
  Serial.println("R = Receber");
  Serial.println();
}

// ======================================================
// LOOP PRINCIPAL
// ======================================================

void loop() {
  if (modoAtual == MENU) {
    String escolha;

    if (lerLinhaSerial(escolha)) {
      if (comandoEh(escolha, "E")) {
        definirModo(EMITIR);
      }
      else if (comandoEh(escolha, "R")) {
        definirModo(RECEBER);
      }
      else {
        Serial.println(
          "Digite E para emitir ou R para receber."
        );
      }
    }

    return;
  }

  if (modoAtual == EMITIR) {
    String entrada;

    if (lerLinhaSerial(entrada)) {
      if (comandoEh(entrada, ":R") ||
          comandoEh(entrada, ":RECEBER")) {
        definirModo(RECEBER);
      }
      else if (comandoEh(entrada, ":E") ||
               comandoEh(entrada, ":EMITIR")) {
        Serial.println("O modo emissor ja esta ativo.");
      }
      else if (entrada.length() > 2 &&
               entrada[0] == ':' &&
               (entrada[1] == 'F' || entrada[1] == 'f') &&
               soDigitos(entrada, 2)) {
        testarFrequencia(entrada.substring(2).toInt());
      }
      else if (entrada.length() > 0) {
        transmitirTexto(entrada);
      }
    }

    return;
  }

  if (modoAtual == RECEBER) {
    executarReceptor();
  }
}
