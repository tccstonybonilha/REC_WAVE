// ======================================================
// DETECTOR DE SOM
//
// Le blocos de amostras e calcula a energia de TOM (Goertzel
// com janela de Hann) em cada bin da faixa escutada. A
// amplitude do bloco e a do bin mais forte, convertida para
// "pico a pico equivalente" (mesma escala do limiar). Decide
// entre som e silencio com histerese e mede a duracao de
// cada pulso. A frequencia so serve para separar tom de ruido.
// ======================================================

void inicializarGoertzel() {
  for (int i = 0; i < BLOCO_AMOSTRAS; i++) {
    janelaHann[i] =
      0.5f * (1.0f - cosf(2.0f * PI * i / BLOCO_AMOSTRAS));
  }

  for (int b = 0; b < NUM_BINS_MAX; b++) {
    coefGoertzel[b] =
      2.0f * cosf(2.0f * PI * (K_MIN_ABS + b) / BLOCO_AMOSTRAS);
  }
}

int freqDoBin(int bin) {
  return (int)(bin * SAMPLING_FREQUENCY / BLOCO_AMOSTRAS + 0.5);
}

int lerAmplitudeBloco() {
  const unsigned long periodo =
    (unsigned long)(1000000.0 / SAMPLING_FREQUENCY);

  const int offset = kMin - K_MIN_ABS;
  const int nBins = kMax - kMin + 1;

  float s1[NUM_BINS_MAX];
  float s2[NUM_BINS_MAX];

  for (int b = 0; b < nBins; b++) {
    s1[b] = 0;
    s2[b] = 0;
  }

  unsigned long proximo = micros();

  for (uint16_t i = 0; i < BLOCO_AMOSTRAS; i++) {
    // Amostragem em instantes absolutos (sem acumular erro).
    while ((long)(micros() - proximo) < 0) {
      // espera o instante da amostra
    }

    proximo += periodo;

    int valor = analogRead(MIC_PIN);

    // Remove o nivel DC (o MAX9814 fica em ~1,25 V).
    if (!dcInicializado) {
      dcEstimado = (float)valor;
      dcInicializado = true;
    }

    dcEstimado += DC_ALFA * ((float)valor - dcEstimado);

    float x = ((float)valor - dcEstimado) * janelaHann[i];

    for (int b = 0; b < nBins; b++) {
      float s0 = coefGoertzel[offset + b] * s1[b] - s2[b] + x;
      s2[b] = s1[b];
      s1[b] = s0;
    }
  }

  float melhor = 0;
  int melhorBin = kMin;

  for (int b = 0; b < nBins; b++) {
    float p = s1[b] * s1[b] + s2[b] * s2[b]
              - coefGoertzel[offset + b] * s1[b] * s2[b];

    if (p < 0) {
      p = 0;
    }

    if (p > melhor) {
      melhor = p;
      melhorBin = kMin + b;
    }
  }

  binDominante = melhorBin;

  // Com janela de Hann: amplitude do tom A = 4*|X|/N, e o
  // pico a pico equivalente e 2*A = 8*|X|/N.
  float amplitude = 8.0f * sqrtf(melhor) / BLOCO_AMOSTRAS;

  if (amplitude > 4095.0f) {
    amplitude = 4095.0f;
  }

  return (int)amplitude;
}

void atualizarLimiares() {
  int ligar = limiarMinimo;

  if (LIMIAR_ADAPTATIVO) {
    int adaptado =
      (int)(ruidoBase * FATOR_RUIDO) + MARGEM_RUIDO;

    if (adaptado > ligar) {
      ligar = adaptado;
    }
  }

  if (ligar > LIMIAR_MAXIMO) {
    ligar = LIMIAR_MAXIMO;
  }

  limiarOn = ligar;
  limiarOff = (int)(ligar * HISTERESE);
}

void atualizarRuido(int amplitude) {
  if (!LIMIAR_ADAPTATIVO) {
    return;
  }

  ruidoBase += RUIDO_ALFA * ((float)amplitude - ruidoBase);

  atualizarLimiares();
}

// Mede o ruido ambiente ao entrar em RECEBER, para o limiar
// ja comecar adequado ao local (o MAX9814 tem ruido proprio).
void semearRuido() {
  if (!LIMIAR_ADAPTATIVO) {
    return;
  }

  long soma = 0;

  for (int i = 0; i < AMOSTRAS_RUIDO_INICIAL; i++) {
    soma += lerAmplitudeBloco();
  }

  ruidoBase = (float)soma / AMOSTRAS_RUIDO_INICIAL;
  atualizarLimiares();

  Serial.print("Ruido ambiente medido: ");
  Serial.print(ruidoBase, 1);
  Serial.print(" | limiar liga ");
  Serial.print(limiarOn);
  Serial.print(", desliga ");
  Serial.println(limiarOff);
}

void detectorReiniciar() {
  detSomAtivo = false;
  detIgnorandoRuido = false;
  detAltosSeguidos = 0;
  detAmplitudePico = 0;
  detNumBlocos = 0;
}

void gravarBloco(int amplitude, unsigned long tempo) {
  if (detNumBlocos < MAX_BLOCOS_PULSO) {
    detAmplitudes[detNumBlocos] = (uint16_t)amplitude;
    detTempos[detNumBlocos] = tempo;
    detNumBlocos++;
  }
}

// Mede o pulso a FRACAO_CORTE_PICO (70%) do pico.
// Envelope suavizado (media de 3 blocos); o inicio e o fim sao
// os instantes em que o envelope cruza o corte (nunca abaixo
// do limiar de desligar). Assim, volume fraco, cauda de
// reverberacao e subida lenta do AGC distorcem menos a duracao.
bool medirPulsoNoCorte(unsigned long &inicio, unsigned long &fim) {
  static int envelope[MAX_BLOCOS_PULSO];

  int n = detNumBlocos;

  if (n < 2) {
    return false;
  }

  int picoEnvelope = 0;

  for (int i = 0; i < n; i++) {
    int soma = detAmplitudes[i];
    int cont = 1;

    if (i > 0) {
      soma += detAmplitudes[i - 1];
      cont++;
    }

    if (i < n - 1) {
      soma += detAmplitudes[i + 1];
      cont++;
    }

    envelope[i] = soma / cont;

    if (envelope[i] > picoEnvelope) {
      picoEnvelope = envelope[i];
    }
  }

  int corte = (int)(picoEnvelope * FRACAO_CORTE_PICO);

  if (corte < limiarOff) {
    corte = limiarOff;
  }

  for (int tentativa = 0; tentativa < 2; tentativa++) {
    int primeiro = -1;
    int ultimo = -1;

    for (int i = 0; i < n; i++) {
      if (envelope[i] >= corte) {
        if (primeiro < 0) {
          primeiro = i;
        }

        ultimo = i;
      }
    }

    if (primeiro >= 0) {
      inicio = detTempos[primeiro] - BLOCO_MS;
      fim = detTempos[ultimo];
      return true;
    }

    // Pulso fraco: o envelope suavizado nao chegou ao limiar.
    corte = (int)(picoEnvelope * FRACAO_CORTE_PICO);
  }

  return false;
}

// Processa UM bloco de amostras (~6 ms).
// Retorna true quando um pulso terminou (ev preenchido) ou
// quando um som excedeu a duracao maxima (ruido continuo).
bool detectorProcessar(EventoPulso &ev) {
  int amplitude = lerAmplitudeBloco();
  unsigned long agora = millis();

  bool alto = detSomAtivo
    ? (amplitude >= limiarOff)
    : (amplitude >= limiarOn);

  // ---- Silencio: procura o inicio de um som ----
  if (!detSomAtivo) {
    if (alto) {
      if (detAltosSeguidos == 0) {
        detInicioCandidato = agora - BLOCO_MS;
        detNumBlocos = 0;
      }

      gravarBloco(amplitude, agora);

      detAltosSeguidos++;

      if (detAltosSeguidos >= BLOCOS_CONFIRMA_INICIO) {
        detSomAtivo = true;
        detIgnorandoRuido = false;
        detInicioSom = detInicioCandidato;
        detUltimoAlto = agora;
        detAmplitudePico = amplitude;
        detBinPico = binDominante;
      }
    }
    else {
      detAltosSeguidos = 0;
      detNumBlocos = 0;
      atualizarRuido(amplitude);
    }

    return false;
  }

  // ---- Som ativo ----
  if (!detIgnorandoRuido) {
    gravarBloco(amplitude, agora);
  }

  if (alto) {
    detUltimoAlto = agora;

    if (amplitude > detAmplitudePico) {
      detAmplitudePico = amplitude;
      detBinPico = binDominante;
    }

    if (detIgnorandoRuido) {
      // Ruido continuo: o limiar sobe ate o ruido virar "silencio".
      atualizarRuido(amplitude);
      return false;
    }

    if (agora - detInicioSom > MAX_PULSO_MS) {
      detIgnorandoRuido = true;
      totalRuidosContinuos++;

      ev.duracao = agora - detInicioSom;
      ev.fimMs = agora;
      ev.amplitudePico = detAmplitudePico;
      ev.binPico = detBinPico;

      return true;
    }

    return false;
  }

  // Bloco abaixo do limiar durante um som.
  if (detIgnorandoRuido) {
    atualizarRuido(amplitude);
  }

  // O som so termina apos um silencio minimo; pequenas
  // falhas dentro do mesmo bip sao absorvidas.
  if (agora - detUltimoAlto >= DEBOUNCE_SILENCIO_MS) {
    detSomAtivo = false;
    detAltosSeguidos = 0;

    if (detIgnorandoRuido) {
      detIgnorandoRuido = false;
      return false;
    }

    unsigned long inicioMedido = 0;
    unsigned long fimMedido = 0;

    if (!medirPulsoNoCorte(inicioMedido, fimMedido)) {
      totalRuidosFiltrados++;
      return false;
    }

    unsigned long duracao = fimMedido - inicioMedido;

    if (duracao < MIN_PULSO_MS) {
      totalRuidosFiltrados++;
      return false;
    }

    ev.duracao = duracao;
    ev.fimMs = fimMedido;
    ev.amplitudePico = detAmplitudePico;
    ev.binPico = detBinPico;

    return true;
  }

  return false;
}

// ======================================================
// DECODIFICACAO
// ======================================================

// Simbolo acumulado: Morse usa '.' e '-'; os demais modos
// usam '0' e '1'.
char simboloChar(TipoSinal tipo, ModoId modo) {
  if (modo == ID_ALFA) {
    return (tipo == SINAL_CURTO) ? '.' : '-';
  }

  return (tipo == SINAL_CURTO) ? '0' : '1';
}

char decodificarMorse(const String &simbolos) {
  for (int i = 0; i < 26; i++) {
    if (simbolos == MORSE_LETRAS[i]) {
      return (char)('A' + i);
    }
  }

  return 0;
}

char decodificarNumero(const String &simbolos) {
  for (int i = 0; i < 10; i++) {
    if (simbolos == CODIGO_NUMEROS[i]) {
      return (char)('0' + i);
    }
  }

  return 0;
}

char decodificarEspecial(const String &bits) {
  if (bits.length() != BITS_ESPECIAL) {
    return 0;
  }

  int valor = 0;

  for (int i = 0; i < BITS_ESPECIAL; i++) {
    if (bits[i] != '0' && bits[i] != '1') {
      return 0;   // simbolo desconhecido ('?')
    }

    valor = (valor << 1) | (bits[i] == '1' ? 1 : 0);
  }

  if (valor >= 0x20 && valor <= 0x7E) {
    return (char)valor;
  }

  return 0;
}

// Converte o buffer de caracteres em texto legivel.
String montarTextoRx(const String &chars) {
  String texto = "";

  for (int i = 0; i < (int)chars.length(); i++) {
    if (chars[i] == CHAR_ERRO) {
      texto += "[?]";
    }
    else {
      texto += chars[i];
    }
  }

  return texto;
}

