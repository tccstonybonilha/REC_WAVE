const char *nomeDoSinal(TipoSinal tipo) {
  for (int i = 0; i < NUM_CLASSES; i++) {
    if (CLASSES_SINAL[i].tipo == tipo) {
      return CLASSES_SINAL[i].nome;
    }
  }

  return "INVALIDO";
}

unsigned long duracaoDoSinal(TipoSinal tipo) {
  for (int i = 0; i < NUM_CLASSES; i++) {
    if (CLASSES_SINAL[i].tipo == tipo) {
      return CLASSES_SINAL[i].nominal;
    }
  }

  return 0;
}

// Classifica a duracao medida pela classe mais proxima.
// Fora de [LIM_MIN_VALIDO_MS, LIM_MAX_VALIDO_MS] = invalido.
TipoSinal classificarDuracao(unsigned long duracao) {
  if (duracao < LIM_MIN_VALIDO_MS ||
      duracao > LIM_MAX_VALIDO_MS) {
    return SINAL_INVALIDO;
  }

  if (duracao <= LIM_MODO_NUM_ESP_MS) return SINAL_MODO_NUMERICO;
  if (duracao <= LIM_MODO_ESP_CURTO_MS) return SINAL_MODO_ESPECIAL;
  if (duracao <= LIM_CURTO_LONGO_MS) return SINAL_CURTO;
  if (duracao <= LIM_LONGO_CONTROLE_MS) return SINAL_LONGO;

  return SINAL_CONTROLE;
}

const char *nomeDoModoId(ModoId modo) {
  if (modo == ID_ALFA) return "ALFA";
  if (modo == ID_NUMERICO) return "NUMERICO";
  return "ESPECIAL";
}

// ======================================================
// MODO DE IDENTIFICACAO ADEQUADO A CADA CARACTERE
// ======================================================

ModoId modoDoCaractere(char c) {
  if (c >= 'A' && c <= 'Z') return ID_ALFA;
  if (c >= '0' && c <= '9') return ID_NUMERICO;
  return ID_ESPECIAL;
}

// ======================================================
// NORMALIZACAO DO TEXTO
// - minusculas viram maiusculas (Morse nao tem caixa)
// - acentos comuns do portugues (UTF-8) perdem o acento
// - caracteres fora de ASCII 0x20-0x7E sao ignorados
// - caractere multibyte sem equivalente conta como 1 ignorado
// ======================================================

char removerAcento(uint8_t s) {
  if (s >= 0x80 && s <= 0x85) return 'A';
  if (s == 0x87) return 'C';
  if (s >= 0x88 && s <= 0x8B) return 'E';
  if (s >= 0x8C && s <= 0x8F) return 'I';
  if (s == 0x91) return 'N';
  if (s >= 0x92 && s <= 0x96) return 'O';
  if (s >= 0x99 && s <= 0x9C) return 'U';

  if (s >= 0xA0 && s <= 0xA5) return 'A';
  if (s == 0xA7) return 'C';
  if (s >= 0xA8 && s <= 0xAB) return 'E';
  if (s >= 0xAC && s <= 0xAF) return 'I';
  if (s == 0xB1) return 'N';
  if (s >= 0xB2 && s <= 0xB6) return 'O';
  if (s >= 0xB9 && s <= 0xBC) return 'U';

  return 0;
}

String normalizarTexto(const String &entrada, int &ignorados) {
  String saida = "";
  ignorados = 0;

  int n = entrada.length();

  for (int i = 0; i < n; i++) {
    uint8_t b = (uint8_t)entrada[i];

    if (b == 0xC3 && i + 1 < n) {
      uint8_t segundo = (uint8_t)entrada[i + 1];
      i++;

      char base = removerAcento(segundo);

      if (base != 0) {
        saida += base;
      }
      else {
        ignorados++;
      }

      continue;
    }

    if (b >= 0x80) {
      // Byte de continuacao UTF-8 (10xxxxxx) nao conta de novo:
      // so o byte inicial representa o caractere ignorado.
      if ((b & 0xC0) != 0x80) {
        ignorados++;
      }

      continue;
    }

    if (b >= 'a' && b <= 'z') {
      b = b - 'a' + 'A';
    }

    if (b >= 0x20 && b <= 0x7E) {
      saida += (char)b;
    }
    else if (b != '\r' && b != '\n') {
      ignorados++;
    }
  }

  return saida;
}

// ======================================================
// CHECKSUM
// Soma ponderada pela posicao (detecta troca de ordem e
// caractere perdido). Resultado sempre em 0x20-0x7E, para
// poder ser enviado como caractere ESPECIAL.
// ======================================================

char calcularChecksum(const String &texto) {
  uint32_t soma = 0;
  int n = texto.length();

  for (int i = 0; i < n; i++) {
    soma += (uint32_t)(uint8_t)texto[i] * (uint32_t)(i + 1);
  }

  return (char)(0x20 + (soma % 95));
}

String bitsDoCaractere(char c) {
  String bits = "";

  for (int b = BITS_ESPECIAL - 1; b >= 0; b--) {
    bits += ((((uint8_t)c) >> b) & 1) ? '1' : '0';
  }

  return bits;
}

// ======================================================
// PLANO DE TRANSMISSAO
//
// Texto -> sequencia de simbolos:
//   C = bip de controle (inicio/fim)
//   N = modo numerico para o proximo caractere (100 ms)
//   S = modo especial para o proximo caractere (200 ms)
//   0 = bip curto
//   1 = bip longo
//   | = fim de caractere (intervalo longo apos o bip anterior)
//
// Letras (modo ALFA) nao levam sinal de modo.
// Todo caractere termina em '|', inclusive os especiais.
// O ultimo caractere antes do controle final e o checksum.
// ======================================================

String montarPlano(const String &texto, bool detalhar) {
  String plano = "C";

  int n = texto.length();

  for (int i = 0; i < n; i++) {
    char c = texto[i];
    ModoId modo = modoDoCaractere(c);

    if (modo == ID_NUMERICO) {
      plano += 'N';
    }
    else if (modo == ID_ESPECIAL) {
      plano += 'S';
    }

    String codigo = "";

    if (modo == ID_ALFA) {
      const char *morse = MORSE_LETRAS[c - 'A'];

      for (int k = 0; morse[k] != 0; k++) {
        plano += (morse[k] == '.') ? '0' : '1';
      }

      codigo = morse;
    }
    else if (modo == ID_NUMERICO) {
      const char *num = CODIGO_NUMEROS[c - '0'];

      plano += num;
      codigo = num;
    }
    else {
      codigo = bitsDoCaractere(c);
      plano += codigo;
    }

    plano += '|';

    if (detalhar) {
      Serial.print("'");
      Serial.print(c);
      Serial.print("' -> modo ");
      Serial.print(nomeDoModoId(modo));
      Serial.print(": ");
      Serial.println(codigo);
    }
  }

  char cs = calcularChecksum(texto);

  plano += 'S';
  plano += bitsDoCaractere(cs);
  plano += '|';

  if (detalhar) {
    Serial.print("checksum '");
    Serial.print(cs);
    Serial.print("' -> modo ESPECIAL: ");
    Serial.println(bitsDoCaractere(cs));
  }

  plano += 'C';

  return plano;
}

TipoSinal tipoDoSimboloPlano(char c) {
  if (c == 'C') return SINAL_CONTROLE;
  if (c == 'N') return SINAL_MODO_NUMERICO;
  if (c == 'S') return SINAL_MODO_ESPECIAL;
  if (c == '0') return SINAL_CURTO;
  if (c == '1') return SINAL_LONGO;

  return SINAL_INVALIDO;
}

// ======================================================
// ENVIO DE UM SINAL (com ou sem ping-pong)
// ======================================================

bool enviarSinalConfirmado(TipoSinal tipo) {
  unsigned long duracao = duracaoDoSinal(tipo);

  // Sem ping-pong: apenas emite o bip, sem esperar confirmacao.
  if (!PING_PONG_ATIVO) {
    if (modoAtual != EMITIR) {
      return false;
    }

    totalSinaisEnviados++;

    Serial.print("TX: ");
    Serial.print(nomeDoSinal(tipo));
    Serial.print(" (");
    Serial.print(duracao);
    Serial.println(" ms)");

    return tocarBip(duracao);
  }

  for (int tentativa = 1;
       tentativa <= MAX_TENTATIVAS;
       tentativa++) {

    if (modoAtual != EMITIR) {
      return false;
    }

    totalSinaisEnviados++;

    Serial.print("PING: ");
    Serial.print(nomeDoSinal(tipo));
    Serial.print(" (");
    Serial.print(duracao);
    Serial.print(" ms, tentativa ");
    Serial.print(tentativa);
    Serial.println(")...");

    unsigned long inicioEnvio = millis();

    if (!tocarBip(duracao)) {
      return false;
    }

    unsigned long fimEnvio = millis();

    if (!aguardarMs(GUARDA_POS_EMISSAO_MS)) {
      return false;
    }

    detectorReiniciar();

    bool confirmou = false;
    unsigned long tempoRTT = 0;

    while (millis() - fimEnvio < TIMEOUT_ECO_MS) {
      if (verificarComandoTroca()) {
        return false;
      }

      if (modoAtual != EMITIR) {
        return false;
      }

      EventoPulso ev;

      if (detectorProcessar(ev)) {
        TipoSinal recebido = classificarDuracao(ev.duracao);

        if (recebido == tipo) {
          confirmou = true;
          tempoRTT = millis() - inicioEnvio;
          break;
        }

        Serial.print("Sinal ignorado na espera do eco: ");
        Serial.print(ev.duracao);
        Serial.println(" ms (nao corresponde).");
      }
    }

    if (confirmou) {
      totalSinaisConfirmados++;
      somaTempoConfirmacao += tempoRTT;

      Serial.print("PONG: eco confirmado em ");
      Serial.print(tempoRTT);
      Serial.println(" ms.");

      return true;
    }

    if (tentativa < MAX_TENTATIVAS) {
      totalRetransmissoes++;

      Serial.println(
        "Sem eco correspondente. Reenviando o mesmo sinal..."
      );

      if (!aguardarMs(150)) {
        return false;
      }
    }
  }

  totalFalhas++;

  Serial.print("FALHA: nao houve eco de ");
  Serial.print(nomeDoSinal(tipo));
  Serial.println(
    ". Transmissao interrompida para evitar "
    "continuar sem confirmacao."
  );

  return false;
}

// ======================================================
// ENVIO DO PLANO COMPLETO
// ======================================================

bool enviarPlano(const String &plano) {
  int n = plano.length();

  for (int i = 0; i < n; i++) {
    char c = plano[i];

    if (c == '|') {
      continue;
    }

    if (modoAtual != EMITIR) {
      return false;
    }

    TipoSinal tipo = tipoDoSimboloPlano(c);

    if (!enviarSinalConfirmado(tipo)) {
      return false;
    }

    if (i == n - 1) {
      break;
    }

    // Se o proximo simbolo do plano e '|', o caractere
    // terminou: usa o intervalo longo de fim de caractere.
    unsigned long intervalo =
      (plano[i + 1] == '|')
        ? INTERVALO_FIM_CARACTERE_MS
        : INTERVALO_BIPS_MS;

    if (!aguardarMs(intervalo)) {
      return false;
    }
  }

  return true;
}

// ======================================================
// TRANSMISSOR DE TEXTO
// ======================================================

void transmitirTexto(String entrada) {
  if (entrada.length() == 0) {
    return;
  }

  int ignorados = 0;
  String texto = normalizarTexto(entrada, ignorados);

  Serial.println();
  Serial.print("Texto: ");
  Serial.println(entrada);

  Serial.print("Texto normalizado: ");
  Serial.println(texto);

  if (ignorados > 0) {
    Serial.print("AVISO: ");
    Serial.print(ignorados);
    Serial.println(
      " caractere(s) sem representacao no protocolo "
      "foram ignorados."
    );
  }

  if (texto.length() == 0) {
    Serial.println("Nada para transmitir.");
    return;
  }

  if (texto.length() > MAX_CARACTERES_TX) {
    Serial.print("ERRO: texto maior que ");
    Serial.print(MAX_CARACTERES_TX);
    Serial.println(" caracteres.");
    return;
  }

  String plano = montarPlano(texto, true);

  Serial.print("Plano de bips: ");
  Serial.println(plano);
  Serial.println(
    "(C=controle N=modo numerico S=modo especial "
    "0=curto 1=longo |=fim de caractere)"
  );

  Serial.println("Iniciando transmissao...");

  if (!enviarPlano(plano)) {
    if (modoAtual == EMITIR) {
      Serial.println("Transmissao interrompida.");
    }

    return;
  }

  Serial.println("Transmissao finalizada.");
  imprimirEstatisticasEmissao();
  Serial.println("Digite outro texto ou :R para receber.");
}

// Ajusta a frequencia do buzzer e toca 2 s para teste. Use
// junto com :C no receptor para achar a frequencia que chega
// mais forte no microfone.
void testarFrequencia(int hz) {
  if (hz < FREQUENCIA_MIN || hz > FREQUENCIA_MAX) {
    Serial.print("Frequencia invalida. Use de ");
    Serial.print(FREQUENCIA_MIN);
    Serial.print(" a ");
    Serial.print(FREQUENCIA_MAX);
