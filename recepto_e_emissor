// ======================================================
// LEITURA DO SERIAL (NAO BLOQUEANTE)
// Acumula bytes ate chegar '\n'. Nunca espera: nao
// distorce a duracao dos bips durante a emissao.
// Retorna true quando uma linha completa foi lida.
// ======================================================

bool lerLinhaSerial(String &linha) {
  while (Serial.available()) {
    char c = (char)Serial.read();

    if (c == '\r') {
      continue;
    }

    if (c == '\n') {
      linha = bufferSerial;
      bufferSerial = "";
      linha.trim();
      return true;
    }

    if (bufferSerial.length() < MAX_LINHA_SERIAL) {
      bufferSerial += c;
    }
  }

  return false;
}

// ======================================================
// COMPARACAO DE COMANDOS
// ======================================================

bool comandoEh(String entrada, String comando) {
  entrada.trim();
  entrada.toUpperCase();
  comando.toUpperCase();

  return entrada == comando;
}

// true se a partir de 'inicio' ha ao menos 1 caractere e
// todos sao digitos.
bool soDigitos(const String &s, int inicio) {
  if ((int)s.length() <= inicio) {
    return false;
  }

  for (int i = inicio; i < (int)s.length(); i++) {
    if (s[i] < '0' || s[i] > '9') {
      return false;
    }
  }

  return true;
}

// ======================================================
// TROCA DE MODO DO APARELHO (menu / emitir / receber)
// ======================================================

void definirModo(Modo novoModo) {
  noTone(BUZZER_PIN);

  modoAtual = novoModo;

  resetarRecepcao();
  detectorReiniciar();
  calibrando = false;

  Serial.println();
  Serial.println("======================================");

  if (modoAtual == EMITIR) {
    Serial.println("MODO EMITIR ATIVADO");
    Serial.println("Digite um texto para transmitir.");
    Serial.println("Digite :R + ENTER para receber.");
    Serial.println("Digite :F<hz> para testar o buzzer (ex.: :F3000).");
  }
  else if (modoAtual == RECEBER) {
    Serial.println("MODO RECEBER ATIVADO");
    Serial.println("Aguardando sinal acustico...");
    Serial.println("Digite :E + ENTER para emitir.");
    Serial.println("Digite :C + ENTER para calibrar o microfone.");
    Serial.println("Digite :L<valor> para ajustar o limiar (ex.: :L150).");
    Serial.println("Digite :T<hz> para travar a escuta num tom (:T0 = automatico).");
  }

  Serial.println("======================================");
  Serial.println();

  if (modoAtual == RECEBER) {
    semearRuido();
  }
}

// ======================================================
// COMANDO DE TROCA DURANTE UMA OPERACAO EM ANDAMENTO
// Retorna true se o modo do aparelho foi alterado.
// ======================================================

bool verificarComandoTroca() {
  String comando;

  if (!lerLinhaSerial(comando)) {
    return false;
  }

  if (modoAtual == EMITIR &&
      (comandoEh(comando, ":R") ||
       comandoEh(comando, ":RECEBER"))) {
    definirModo(RECEBER);
    return true;
  }

  if (modoAtual == RECEBER &&
      (comandoEh(comando, ":E") ||
       comandoEh(comando, ":EMITIR"))) {
    definirModo(EMITIR);
    return true;
  }

  if (comando.length() > 0) {
    Serial.println(
      "(entrada ignorada: operacao em andamento)"
    );
  }

  return false;
}

// ======================================================
// ESPERA NAO TRAVADA (interrompivel por :R / :E)
// Retorna false se o modo mudou durante a espera.
// ======================================================

bool aguardarMs(unsigned long ms) {
  Modo modoInicial = modoAtual;
  unsigned long inicio = millis();

  while (millis() - inicio < ms) {
    if (verificarComandoTroca()) {
      return false;
    }

    if (modoAtual != modoInicial) {
      return false;
    }

    delay(1);
  }

  return modoAtual == modoInicial;
}

// ======================================================
// EMITE UM BIP COM A DURACAO INDICADA
// ======================================================

bool tocarBip(unsigned long ms) {
  tone(BUZZER_PIN, frequenciaBuzzer);

  bool ok = aguardarMs(ms);

  noTone(BUZZER_PIN);

  return ok;
}

